# Optional overrides. For a simple local run you can leave defaults from docker-compose.yml.
APP_NAME=my_app
APP_ENV=demo
LOKI_TIMEOUT_SECONDS=3

# Internal compose URL. From the app container use service name "loki", not localhost.
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push

# Grafana demo credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# You can pin images here if required by your environment.
LOKI_IMAGE=grafana/loki:3.7.0
GRAFANA_IMAGE=grafana/grafana:latest
